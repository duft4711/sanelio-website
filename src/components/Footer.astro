---
import { site } from "../data/site";
import { basePath, withBase } from "../data/navigation";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="wordmark wordmark-footer" href={basePath}>
        <span class="wordmark-mark" aria-hidden="true">S</span>
        <span>{site.name}</span>
      </a>
      <p>Technologie verstehen. Anwendungen nachvollziehen.</p>
    </div>

    <nav aria-label="Fußnavigation">
      <a href={withBase("/kontakt/")}>Kontakt</a>
      <a href={withBase("/impressum/")}>Impressum</a>
      <a href={withBase("/datenschutz/")}>Datenschutz</a>
    </nav>
  </div>
</footer>
