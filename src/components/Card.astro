---
interface Props {
  title: string;
  description: string;
  href?: string;
  label?: string;
}

const { title, description, href, label = "Mehr erfahren" } = Astro.props;
---

<article class="card">
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  {
    href && (
      <a class="text-link" href={href}>
        {label}
        <span aria-hidden="true"> →</span>
      </a>
    )
  }
</article>
