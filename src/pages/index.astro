---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Technologie verstehen</p>
      <h1>Komplexe Technik. Klar eingeordnet.</h1>
      <p class="lead">
        Sanelio erklärt technologische Entwicklungen verständlich und zeigt, wie
        KI, Automatisierung und digitale Werkzeuge praktisch eingesetzt werden
        können.
      </p>
      <div class="hero-actions">
        <a class="button" href="/technologie-verstehen/">Themen entdecken</a>
        <a class="button button-secondary" href="/prime/">Prime kennenlernen</a>
      </div>
    </div>

    <aside class="hero-panel" aria-labelledby="approach-title">
      <h2 id="approach-title">Unser Ansatz</h2>
      <ol>
        <li>verständlich erklären</li>
        <li>praktisch einordnen</li>
        <li>transparent dokumentieren</li>
      </ol>
    </aside>
  </section>

  <section class="section section-muted" aria-labelledby="topics-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Orientierung</p>
        <h2 id="topics-title">Drei Zugänge zur Technologie</h2>
      </div>
      <p>
        Grundlagen, konkrete Anwendungen und eine nüchterne Einordnung gehören
        zusammen.
      </p>
    </div>
    <div class="card-grid">
      <Card
        title="Technologie verstehen"
        description="Begriffe und Zusammenhänge ohne vorausgesetztes Spezialwissen."
        href="/technologie-verstehen/"
      />
      <Card
        title="Prime"
        description="Ein zentrales Sanelio-Projekt, dessen Entwicklung nachvollziehbar dokumentiert wird."
        href="/prime/"
      />
      <Card
        title="Projekte"
        description="Eine vorbereitete Struktur für überprüfbare Praxisberichte und Fallstudien."
        href="/projekte/"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="principle-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Sanelio</p>
        <h2 id="principle-title">Verständlich statt vereinfachend</h2>
      </div>
      <p>
        Sanelio trennt belegte Erkenntnisse, offene Fragen und Entscheidungen
        sichtbar voneinander. So bleibt Technik zugänglich, ohne Unsicherheit zu
        verstecken.
      </p>
    </div>
    <a class="text-link" href="/ueber-sanelio/">
      Mehr über Sanelio <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
