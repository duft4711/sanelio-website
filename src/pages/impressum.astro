---
import BaseLayout from "../layouts/BaseLayout.astro";
import Notice from "../components/Notice.astro";
import SectionIntro from "../components/SectionIntro.astro";
---

<BaseLayout
  title="Impressum – Entwurf | Sanelio"
  description="Nicht veröffentlichungsreifer Platzhalter für das Impressum."
  noindex={true}
>
  <div class="page-shell">
    <SectionIntro
      eyebrow="Rechtlicher Entwurf"
      title="Impressum"
      description="Diese Seite ist ausdrücklich kein vollständiges oder geprüftes Impressum."
    />

    <Notice title="Nicht veröffentlichungsreif" tone="warning">
      Die gesetzlich erforderlichen Angaben fehlen. Betreiber, Anschrift,
      Kontaktangaben und gegebenenfalls weitere Pflichtangaben müssen von
      Norbert bereitgestellt und rechtlich geprüft werden.
    </Notice>

    <div class="prose content-width">
      <h2>Erforderliche Freigaben</h2>
      <ul>
        <li>verantwortlicher Betreiber und vollständige Anschrift</li>
        <li>verifizierte Kontaktangaben</li>
        <li>gegebenenfalls berufs- oder unternehmensbezogene Pflichtangaben</li>
        <li>rechtliche Prüfung des endgültigen Wortlauts</li>
      </ul>
    </div>
  </div>
</BaseLayout>
