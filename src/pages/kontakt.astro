---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Kontakt | Sanelio"
  description="Sanelio per E-Mail kontaktieren."
>
  <div class="page-shell">
    <SectionIntro
      eyebrow="Kontakt"
      title="Kontakt aufnehmen"
      description="Sie erreichen Sanelio derzeit per E-Mail."
    />

    <div class="prose content-width">
      <p>
        Schreiben Sie an
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
      <p>
        Ein Kontaktformular wird nicht eingesetzt. Informationen zur
        Verarbeitung Ihrer Angaben bei einer Kontaktaufnahme finden Sie in der
        <a href="/datenschutz/">Datenschutzerklärung</a>.
      </p>
    </div>
  </div>
</BaseLayout>
