---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import Notice from "../../components/Notice.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { withBase } from "../../data/navigation";
---

<BaseLayout
  title="Prime | Sanelio"
  description="Prime ist ein zentrales Projekt innerhalb von Sanelio."
>
  <div class="page-shell">
    <SectionIntro
      eyebrow="Projekt"
      title="Prime"
      description="Prime ist ein zentrales Projekt innerhalb von Sanelio. Die öffentliche Dokumentation soll seine Entstehung, Arbeitsweise und Weiterentwicklung nachvollziehbar machen."
    />

    <Notice title="Öffentliche Dokumentation">
      Die Darstellung enthält bewusst keine internen Systeme, Verwaltungsdaten
      oder vertraulichen Informationen. Weiterführende Projektaussagen werden
      jeweils fachlich und persönlich geprüft.
    </Notice>

    <div class="card-grid">
      <Card
        title="Entstehung"
        description="Eine vorbereitete, noch freizugebende Darstellung der Ausgangslage und Entwicklung."
        href={withBase("/prime/entstehung/")}
      />
      <Card
        title="Prinzipien und Arbeitsweise"
        description="Wie nachvollziehbare und verantwortete Zusammenarbeit beschrieben werden kann."
        href={withBase("/prime/prinzipien-und-arbeitsweise/")}
      />
      <Card
        title="Weiterentwicklung"
        description="Ein Rahmen, um praktische Erkenntnisse und begründete Änderungen zu dokumentieren."
        href={withBase("/prime/weiterentwicklung/")}
      />
      <Card
        title="KI-Verfügbarkeit und Resilienz"
        description="Warum für Prime ergänzend ein zweiter, lokal betriebener KI-Arbeitsweg geprüft wird."
        href={withBase("/prime/ki-verfuegbarkeit-und-resilienz/")}
      />
      <Card
        title="KI-Agenten in der Praxis"
        description="Warum klare Anforderungen bei der Umsetzung technischer Ideen entscheidend sind."
        href={withBase("/prime/ki-agenten-klare-anforderungen/")}
      />
    </div>
  </div>
</BaseLayout>
