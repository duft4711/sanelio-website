---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { withBase } from "../../data/navigation";
---

<BaseLayout
  title="Prime | Sanelio"
  description="Prime ist ein zentrales Projekt innerhalb von Sanelio."
>
  <div class="page-shell">
    <SectionIntro
      eyebrow="Projekt"
      title="Prime"
      description="Prime ist ein persönlicher digitaler Mitarbeiter. Die öffentliche Dokumentation erklärt seinen Zweck, seine Arbeitsprinzipien und seine Weiterentwicklung."
    />

    <div class="card-grid">
      <Card
        title="Entstehung"
        description="Warum Prime als langfristig angelegtes Assistenzsystem entsteht und wie es eingeordnet wird."
        href={withBase("/prime/entstehung/")}
      />
      <Card
        title="Prinzipien und Arbeitsweise"
        description="Welche Grundsätze die Zusammenarbeit mit Prime leiten."
        href={withBase("/prime/prinzipien-und-arbeitsweise/")}
      />
      <Card
        title="Weiterentwicklung"
        description="Wie praktische Erfahrungen zu begründeten und verhältnismäßigen Verbesserungen führen."
        href={withBase("/prime/weiterentwicklung/")}
      />
      <Card
        title="KI-Verfügbarkeit und Resilienz"
        description="Warum für Prime ergänzend ein zweiter, lokal betriebener KI-Arbeitsweg geprüft wird."
        href={withBase("/prime/ki-verfuegbarkeit-und-resilienz/")}
      />
      <Card
        title="KI-Agenten in der Praxis"
        description="Warum klare Anforderungen bei der Umsetzung technischer Ideen entscheidend sind."
        href={withBase("/prime/ki-agenten-klare-anforderungen/")}
      />
    </div>
  </div>
</BaseLayout>
